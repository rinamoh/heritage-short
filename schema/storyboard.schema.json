{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritage-short.local/schema/storyboard.schema.json",
  "title": "Heritage Short Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "audience",
    "intent",
    "language",
    "style_block",
    "character",
    "voice",
    "music",
    "output",
    "shots"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "const": "am"
    },
    "style_block": {
      "type": "string",
      "minLength": 1
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "looks"],
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1
        },
        "looks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "stage", "clothing", "carries", "ref_image"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "clothing": {
                "type": "string",
                "minLength": 1
              },
              "carries": {
                "type": "string"
              },
              "ref_image": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "name", "style", "settings"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["addis", "gemini"]
        },
        "model": {
          "type": ["string", "null"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": ["string", "null"]
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speed": {
              "type": "number"
            },
            "stability": {
              "type": "number"
            },
            "similarity": {
              "type": "number"
            },
            "style": {
              "type": "number"
            }
          }
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caption",
        "bpm",
        "key",
        "duration_s",
        "instrumental",
        "seed",
        "cues",
        "chosen"
      ],
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "bpm": {
          "type": "integer",
          "minimum": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "instrumental": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer"
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "in_s", "out_s", "shots", "description"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "in_s": {
                "type": "number",
                "minimum": 0
              },
              "out_s": {
                "type": "number",
                "minimum": 0
              },
              "shots": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "chosen": {
          "type": ["string", "null"]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "ratios", "end_card_s"],
      "properties": {
        "fps": {
          "type": "integer",
          "const": 24
        },
        "ratios": {
          "type": "array",
          "const": ["9:16", "16:9"]
        },
        "end_card_s": {
          "type": "number",
          "const": 3
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "beat",
          "reason",
          "shot_size",
          "look",
          "duration_s",
          "narration",
          "subtitle_en",
          "keyframe",
          "motion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "beat": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "shot_size": {
            "type": "string",
            "minLength": 1
          },
          "look": {
            "type": ["string", "null"]
          },
          "duration_s": {
            "type": "number",
            "minimum": 3,
            "maximum": 12
          },
          "narration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text_am"],
            "properties": {
              "text_am": {
                "type": "string"
              },
              "style_override": {
                "type": ["string", "null"]
              }
            }
          },
          "subtitle_en": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 42
              }
            }
          },
          "keyframe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "seed"],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "seed": {
                "type": "integer"
              }
            }
          },
          "motion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "prompt", "seed", "kb_direction"],
            "properties": {
              "method": {
                "type": "string",
                "enum": ["kenburns", "wan"]
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "seed": {
                "type": "integer"
              },
              "kb_direction": {
                "type": "string",
                "enum": ["in", "out", "left", "right"]
              }
            }
          }
        }
      }
    }
  }
}
